library(CEMiTool)
library(CEMiTool)
version
library('CEMiTool')
cancer_types <- c("BRCA",
"GBM",
"LUAD",
"UCEC",
"KIRC",
"HNSC",
"THCA",
"LUSC",
"PRAD",
"COAD",
"STAD",
"BLCA",
"LIHC",
"KIRP",
"ESCA",
"READ",
"KICH",
"CHOL"
)
for(tumor in cancer_types){
}
for(tumor in cancer_types){
setwd(paste("/data/user/vendela/case_studies/output/",tumor,"/co-expression/", sep = ""))
dataFilt <- read.csv(paste(tumor,"_coex_dataFilt.csv", sep = ""))
rownames(dataFilt) <- dataFilt$X
dataFilt <- dataFilt[,-1]
colnames(dataFilt) <- gsub(x = colnames(dataFilt), pattern = "\\.", replacement = "-")
dataFilt_voom = voom(dataFilt)$E
dataFilt_ok <- as.data.frame(dataFilt_voom)
cem <- cemitool(dataFilt_ok)
cem #to have basics information on the modules and selected genes
filter_expr(cem)
nmodules(cem)
head(module_genes(cem))
modules<- module_genes(cem)
hubs <- get_hubs(cem,10)
hubs_M1 <- as.data.frame(hubs[["M1"]])
hubs_M2 <- as.data.frame(hubs[["M2"]])
hubs_M3 <- as.data.frame(hubs[["M3"]])
hubs_M4 <- as.data.frame(hubs[["M4"]])
write.table(hubs, sep = "\t", "hubs.txt")
}
