tumor.met <- get(load("/data/user/vendela/case_studies/data/BRCA.DNAmet.exp.rda"))
tumor.exp <- get(load("/data/user/vendela/case_studies/github/1.TCGA_download_prepare/brca.exp.rda"))
rowis <- rowData(tumor.met[which(tumor.met$patient %in% tumor.exp$patient),])
met_assay <- assay(tumor.met[which(tumor.met$patient %in% tumor.exp$patient),])
met_assay <- met_assay[complete.cases(met_assay),]
for(rok in rownames(met_assay)){
genes <- strsplit(rowis[which(rowis$Composite.Element.REF == rok),]$Gene_Symbol, ";")[[1]]
genes <- unique(genes)
genes <- paste(genes, collapse = ";")
rownames(met_assay) <- gsub(rownames(met_assay), pattern = rok, replacement = genes)
#mean(log2(dataFilt[which(rownames(dataFilt) %in% genes),]+1))
#mean(log2(met_assay[which(rownames(met_assay) == rowis[1,]$Composite.Element.REF),]+1))
}
dataFilt <- get(load("/data/user/vendela/case_studies/github/1.TCGA_download_prepare/BRCA_dataFilt.rda"))
poslist <- c()
for(gen in rownames(met_assay)){
gename <- strsplit(gen, ";")[[1]]
if(length(gename) > 1){
for(gname in seq(1,length(gename))){
epipos <- which(rownames(dataFilt) == gename[gname])
poslist <- c(poslist, epipos)
}
}else{
epipos <- which(rownames(dataFilt) == gename)
poslist <- c(poslist, epipos)
}
}
dataFilt_epi <- dataFilt[poslist,]
met_assay <- assay(tumor.met[which(tumor.met$patient %in% tumor.exp$patient),])
met_assay <- met_assay[complete.cases(met_assay),]
