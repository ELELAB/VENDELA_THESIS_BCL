library(ggplot2)
mutationfile <- read.csv("/data/user/vendela/case_studies/output/BRCA/mutations/BRCA_mutations_short.csv")
mutationfile$Hugo_Symbol <- as.character(mutationfile$Hugo_Symbol)
mutationfile$IMPACT <- as.character(mutationfile$IMPACT)
impacts <- sort(unique(mutationfile$IMPACT))
mutation_impact <- data.frame()
for(gene in geneNames){
mutfile_gene <- subset(mutationfile, Hugo_Symbol == gene)
genename <- c(rep(gene, 4))
d_frame <- as.data.frame(genename)
colnames(d_frame) <- "Hugo_Symbol"
d_frame$IMPACT <- impacts
d_frame$number_of_times <- c(rep(0, 4))
for(imp in impacts){
lenlen <- length(which(mutfile_gene$IMPACT == imp))
pos_imp <- which(d_frame$IMPACT == imp)
d_frame[pos_imp,]$number_of_times <- lenlen
}
mutation_impact <- rbind(mutation_impact, d_frame)
}
